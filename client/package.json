{
    "name": "arch-web-push-client",
    "version": "0.1.0",
    "description": "Browser client helper for Arch Push Notifications (APN)",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "web-push",
        "push-notifications",
        "service-worker",
        "notifications",
        "vapid"
    ],
    "author": "Sepehr Samavati",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sepehrsamavati/arch-push-notifications.git",
        "directory": "client"
    },
    "bugs": {
        "url": "https://github.com/sepehrsamavati/arch-push-notifications/issues"
    },
    "homepage": "https://github.com/sepehrsamavati/arch-push-notifications#readme",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "tsup": "^8.5.0",
        "typescript": "^5.9.3"
    }
}
